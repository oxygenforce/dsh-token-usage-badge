{
  "name": "dsh-token-usage-badge",
  "version": "1.1.14",
  "description": "在每条回答下方显示本轮 Token 用量、回答耗时与会话累计 Token / Per-reply token usage, answer duration, and session total for DeepSeek Harness",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token",
    "token-usage",
    "badge",
    "usage",
    "duration",
    "status",
    "ui"
  ],
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets/preview.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "author": "oxygenforce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxygenforce/dsh-token-usage-badge.git"
  },
  "homepage": "https://github.com/oxygenforce/dsh-token-usage-badge",
  "bugs": {
    "url": "https://github.com/oxygenforce/dsh-token-usage-badge/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  }
}
